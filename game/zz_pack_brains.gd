extends RefCounted

## Runs a pack's own brain on this game's zombie body. A pack monster is a re-skinned [ZzZombieBody] (the
## client draws a zombie), but its attacks live in the pack's brain, written for the pack's own body. This
## writes, per pack brain, a script that extends it by path (a path cannot be named in a `.gd` of ours: the
## pack may not be installed) and replaces only what touches the body:
##
## [codeblock]
## _body()        the brain's view of its body: ZzPackBody (action, variant, limb scales, limb_severed)
## steer_toward   writes the body's wish; the horde moves it once a tick (stride, step-up, shoves)
## halt           wish zero
## _enter_leap / _tick_leap   a pounce is the body's own leap (ZzZombieBody.leap), landing ends it
## stagger        what the horde calls for a blast or a shove
## state          `hunt` read as the game's `chase`
## [/codeblock]
##
## The script is written to `user://zz_pack_brains/` (a real file the spawner can load by path). Server only:
## clients never run a brain.

const DIR := "user://zz_pack_brains"
const ADAPTER := preload("../npcs/zz_pack_body.gd")

## The monsters pack's layout (zz-historical-monsters), found next to its provider.
const ZHM_BRAIN := "runtime/zhm_brain.gd"
const ZHM_CONFIG := "core/zhm_config.gd"
const ZHM_CATALOGUE := "core/zhm_catalogue.gd"

const SOURCE := """extends "%s"

## Generated by ZzPackBrains. Do not edit: see game/zz_pack_brains.gd.

var _pack_body: Node = null
var _stagger_until: float = 0.0
## A pack monster does not bash barricades (the game's stuck watch asks).
var bashing: bool = false
## What the game reads of any brain (the stuck watch): hunting is chasing.
var state: StringName:
	get:
		var s: StringName = machine.current() if machine != null else &""
		return &"chase" if s == &"hunt" else s


func _body() -> Node:
	if _pack_body == null or not is_instance_valid(_pack_body):
		var real: Node = npc.node if npc != null else null
		if real == null:
			return null
		_pack_body = load("%s").new()
		_pack_body.call(&"attach", real)
		real.add_child(_pack_body)
	return _pack_body


func steer_toward(to: Vector3, speed: float, _delta: float) -> void:
	if npc == null or not npc.is_alive():
		return
	var direction := to - npc.position()
	direction.y = 0.0
	if direction.length() < 0.001 or npc.node == null:
		return
	direction = direction.normalized()
	npc.node.set(&"wish", direction * speed)
	face(direction)


func halt() -> void:
	_cruise_on = false
	if npc != null and npc.node != null:
		npc.node.set(&"wish", Vector3.ZERO)


func _npc_think(delta: float) -> void:
	if npc == null or npc.node == null:
		return
	if context != null and context.now < _stagger_until:
		halt()
		return
	super(delta)
	var b := _body()
	if b != null:
		b.call(&"apply_gait")


## The horde's shove or blast: knocked back, and it does not act for the length.
func stagger(direction: Vector3, seconds: float, strength: float = 4.0) -> void:
	if npc == null or npc.node == null:
		return
	_stagger_until = maxf(_stagger_until, (context.now if context != null else 0.0) + minf(seconds, 1.5))
	npc.node.call(&"shove", Vector3(direction.x, 0.0, direction.z).normalized() * strength)
	npc.node.set(&"anim", 4)


func force_target(_id: StringName) -> void:
	pass


func lure_to(_at: Vector3) -> void:
	pass


func _enter_leap(_c: DotNpcAiContext) -> void:
	var p: Dictionary = cfg.get("pounce", {})
	_hit_victims.clear()
	_landed = false
	var to := target_position(npc.position())
	_locked_target = to
	var flat := Vector3(to.x - npc.position().x, 0.0, to.z - npc.position().z)
	_locked_dir = flat.normalized() if flat.length() > 0.01 else -npc.node.global_transform.basis.z
	var t := maxf(flat.length() / maxf(_f(p, "speed", 17.0), 1.0), 0.25)
	var up := clampf(((to.y - npc.position().y) + 10.0 * t * t) / t, 3.0, 14.0)
	_set_action(Pose.Anim.LEAP)
	npc.node.call(&"leap", _locked_dir * (flat.length() / t) + Vector3(0.0, up, 0.0))


func _tick_leap(_c: DotNpcAiContext) -> void:
	var p: Dictionary = cfg.get("pounce", {})
	if npc.node == null:
		return
	face(_locked_dir)
	_tick_bleeds()
	if context.now - _entered_at() < 0.12 or bool(npc.node.get(&"flying")):
		return
	if not _landed:
		_landed = true
		for v in _targets_within(_f(p, "hit_radius", 1.8)):
			_hit(v.id, _f(p, "damage", 24.0), &"pounce", _impulse_to(v.position, 3.0))
			_add_bleed(v.id)
	machine.go_to(context, &"land")
"""


## The path of a script that is [param parent] (a pack brain's path) on this game's body; written once per parent.
static func wrapper_for(parent: String) -> String:
	var path := "%s/%s.gd" % [DIR, parent.md5_text()]
	var text := SOURCE % [parent, (ADAPTER as Resource).resource_path]
	if FileAccess.file_exists(path) and FileAccess.get_file_as_string(path) == text:
		return path
	DirAccess.make_dir_recursive_absolute(DIR)
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		return ""
	file.store_string(text)
	file.close()
	return path


## What the game adds to a pack monster row so its own brain runs, or empty: `{brain, meta}`. The row's
## `spawn.brain` (a script path) wins; otherwise the monsters pack is recognised by its layout. [param provider_dir]
## is the pack directory and [param npc_id] the row's id. Every other pack keeps the common's brain.
static func adapt(provider_dir: String, npc_id: StringName, spawn: Dictionary) -> Dictionary:
	var parent := str(spawn.get("brain", ""))
	var meta: Dictionary = (spawn.get("meta", {}) as Dictionary).duplicate()

	if parent == "" and FileAccess.file_exists(provider_dir.path_join(ZHM_BRAIN)) and FileAccess.file_exists(provider_dir.path_join(ZHM_CONFIG)):
		parent = provider_dir.path_join(ZHM_BRAIN)
		var species := _species_of(provider_dir, npc_id)
		var config := _species_config(provider_dir, species)
		if species == &"" or config.is_empty():
			return {}
		meta["species"] = String(species)
		meta["cfg"] = config

	if parent == "" or not FileAccess.file_exists(parent):
		return {}

	var wrapped := wrapper_for(parent)
	return {} if wrapped == "" else {"brain": wrapped, "meta": meta}


static func _species_of(provider_dir: String, npc_id: StringName) -> StringName:
	var cat := load(provider_dir.path_join(ZHM_CATALOGUE)) as GDScript
	return StringName(cat.call(&"species_of", npc_id)) if cat != null else &""


static func _species_config(provider_dir: String, species: StringName) -> Dictionary:
	var config := load(provider_dir.path_join(ZHM_CONFIG)) as GDScript
	if config == null or species == &"":
		return {}
	var loaded: Variant = config.call(&"load_config")
	if loaded == null:
		return {}
	var c: Variant = (loaded as Object).call(&"species", species)
	return c if c is Dictionary else {}
