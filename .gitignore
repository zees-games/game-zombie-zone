# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# A shipped build copies them in instead.
#
# THIS LIST IS ALSO THE DEPENDENCY MANIFEST. gs-bootstrap derives what to link from
# these lines rather than keeping a second copy, because the repository that gains a
# dependency is the repository that has to ignore its link.
/addons/gs_core
/addons/gs_profile
/addons/gs_profiler
/addons/gs_lighting
/addons/gs_map
/addons/gs_entity
/addons/gs_physics
/addons/gs_player
/addons/gs_player_controller
/addons/gs_combat
/addons/gs_player_char
/addons/gs_animation
/addons/gs_save
/addons/gs_camera
/addons/gs_match
/addons/gs_weapon
/addons/gs_ui
/addons/gs_input
/addons/gs_settings
/addons/gs_menu
/addons/gs_mobile
/addons/gs_console
/addons/gs_fx
# bootstrap fetches the release zip into addons/gs_net/native/bin and export copies it beside the exe (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-net v0.1.44 native/bin
/addons/gs_net
/addons/gs_server
/addons/gs_game
# gs-sim: optional native library (movement motor, bot senses, snapshot codec); without its built library the GDScript twins run.
# bootstrap fetches this release's library for the machine (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-sim v0.2.28
/addons/gs_sim
/addons/gs_workbench
/addons/gs_team
/addons/gs_chat
/addons/gs_voice
/addons/gs_moderation
/addons/gs_spectate
/addons/gs_audio
/addons/gs_stats
/addons/gs_achievements
/addons/gs_cloud
/addons/gs_auth
/addons/gs_user
/addons/gs_user_avatar
/addons/gs_platform
/addons/gs_vote
/addons/gs_replay
/addons/gs_npc
/addons/gs_npc_ai
/addons/gs_npc_ai_director
/addons/gs_bot
/addons/gs_props
/addons/zee_weapons
/addons/gs_spawn

# The maps are zombie-zone-maps, a repository and a pack of their own.
# bootstrap-link: zombie-zone-maps/maps ci
/maps

# The converted maps' drawn worlds, for a checkout (game/zz_map.gd load_world). Never in CI or in
# this game's pack: delivered, each world is a pack of its own that a client fetches for its map.
# bootstrap-link: zombie-zone-maps/world
/world

# The raw art stores (about 2 GB, in no repository): staged from GS_STORES_FROM by gs-bootstrap.
# bootstrap-link: zombie-zone-maps/.stores
/.stores

# Optional weapon and monster packs, content repositories of their own (docs/design.md): gs-bootstrap
# links them by default and skips them under --min; the game parses and passes its suites without.
# bootstrap-optional
/addons/zz_modern_weapons
/addons/zz_mutants
# bootstrap-optional
/addons/zz_medieval_weapons
# bootstrap-optional
/addons/zz_historical_monsters
# bootstrap-optional
/addons/zz_ply_class_pack

# Fatal Contact's weapon addon is never a Zombie Zone dependency: a stray link to it stays out of the repository.
# The trailing * keeps gs-ci's resolve-deps (which reads every bare /addons/<name> line as a dependency) from cloning it.
/addons/fc_weapons*

# natural-disasters is not a Zombie Zone dependency either (nothing here names its classes); a local
# link to it (one was committed as an absolute symlink in 84443e9) stays out. Same trailing * reason.
/addons/natural_disasters*

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/

# Editors
.vscode/

# Throwaway probes.
/.scratch/

# tools/bake_lightmaps.sh's bake scenes and the editor's raw output; lightmaps/ is what ships.
/lightbake_work/
/addons/gs_bot_record
/addons/gs_browser
/addons/gs_effects
/addons/gs_leaderboard
/addons/gs_loadout
/addons/gs_objective
/addons/gs_peer_to_peer
/addons/gs_player_class
/addons/gs_server_query

# Godot writes an .import beside each golden when a test run loads it; goldens are read as raw images.
/tests/golden/*.import
# The same for the render reports: they are images for people, nothing loads them.
/reports/**/*.import
/addons/gs_flashlight

/addons/gs_sql
/addons/godot-sqlite
