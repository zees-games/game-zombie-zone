# Godot 4
.godot/
/android/

# Every dot-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
# A shipped build copies them in instead.
#
# THIS LIST IS ALSO THE DEPENDENCY MANIFEST. dot-bootstrap derives what to link from
# these lines rather than keeping a second copy, because the repository that gains a
# dependency is the repository that has to ignore its link.
/addons/dot_core
/addons/dot_profile
/addons/dot_lighting
/addons/dot_map
/addons/dot_entity
/addons/dot_physics
/addons/dot_player
/addons/dot_player_controller
/addons/dot_combat
/addons/dot_player_char
/addons/dot_match
/addons/dot_weapon
/addons/dot_ui
/addons/dot_settings
/addons/dot_menu
/addons/dot_console
/addons/dot_fx
/addons/dot_net
/addons/dot_server
/addons/dot_game
/addons/dot_workbench
/addons/dot_team
/addons/dot_chat
/addons/dot_voice
/addons/dot_moderation
/addons/dot_spectate
/addons/dot_audio
/addons/dot_stats
/addons/dot_achievements
/addons/dot_cloud
/addons/dot_auth
/addons/dot_user
/addons/dot_user_avatar
/addons/dot_platform
/addons/dot_vote
/addons/dot_replay
/addons/dot_npc
/addons/dot_npc_ai
/addons/dot_npc_ai_director
/addons/dot_bot
/addons/dot_props
/addons/zee_weapons
/addons/zed_weapons
/addons/dot_spawn

# The maps are zombie-zone-maps, a repository and a pack of their own.
# bootstrap-link: zombie-zone-maps/maps ci
/maps

# The converted maps' drawn worlds, for a checkout (game/zz_map.gd load_world). Never in CI or in
# this game's pack: delivered, each world is a pack of its own that a client fetches for its map.
# bootstrap-link: zombie-zone-maps/world
/world

# Optional weapon and monster packs, content repositories of their own (docs/design.md): dot-bootstrap
# links them by default and skips them under --min; the game parses and passes its suites without.
# bootstrap-optional
/addons/zz_modern_weapons
# bootstrap-optional
/addons/zz_medieval_weapons
# bootstrap-optional
/addons/zz_historical_monsters

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/

# Editors
.vscode/

# Throwaway probes.
/.scratch/

# tools/bake_lightmaps.sh's bake scenes and the editor's raw output; lightmaps/ is what ships.
/lightbake_work/
